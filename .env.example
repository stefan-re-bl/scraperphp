APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_MAPS_SCRAPER_BIN=google-maps-scraper
GOOGLE_MAPS_SCRAPER_IMAGE=gosom/google-maps-scraper@sha256:e205c02913c5a69c16fc2094b8e5b194a2f655166d2c1126d50548d216e6b1b2
GOOGLE_MAPS_SCRAPER_USE_DOCKER=true
GOOGLE_MAPS_SCRAPER_TIMEOUT=600

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Enriquecimiento limitado; OSM requiere revisión explícita de su endpoint.
ENRICHMENT_MAX_PAGES=5
ENRICHMENT_MAX_PAGE_BYTES=120000
ENRICHMENT_MAX_TOTAL_BYTES=600000
ENRICHMENT_MAX_TOTAL_SECONDS=25
ENRICHMENT_REQUEST_TIMEOUT_SECONDS=8
ENRICHMENT_TTL_HOURS=24
ENRICHMENT_EVIDENCE_TTL_DAYS=30
ENRICHMENT_DOMAIN_MIN_INTERVAL_SECONDS=1
ENRICHMENT_USER_AGENT=CRTWebEvidenceBot/1.0
ENRICHMENT_OSM_ENABLED=false
ENRICHMENT_OSM_ENDPOINT=
ENRICHMENT_OSM_TERMS_ACKNOWLEDGED=false
ENRICHMENT_OSM_USER_AGENT=
ENRICHMENT_OSM_RADIUS_METRES=100
ENRICHMENT_OSM_MIN_INTERVAL_SECONDS=60
ENRICHMENT_OSM_TTL_HOURS=168
